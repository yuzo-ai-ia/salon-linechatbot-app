# ===================================================================
# 環境変数テンプレート
#   使い方 : cp .env.local.example .env.local して実際の値を記入する
#   ルール : .env.local はコミットしない（.gitignore 済み）。
#            このテンプレート（値なし）だけコミットする。
#            値は必ず lib/env.ts 経由で読む（process.env を直接見ない）。
# ===================================================================

# --- Supabase（現フェーズで必須）-----------------------------------
# プロジェクト URL。Studio > Project Settings > API / Data API。
# 公開前提なので NEXT_PUBLIC_ を付けてよい。
NEXT_PUBLIC_SUPABASE_URL=

# Publishable キー（新形式 sb_publishable_... / 旧 anon 相当・RLS 有効）。
# ブラウザに埋め込まれる前提。実データは RLS で保護する。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret キー（新形式 sb_secret_... / 旧 service_role 相当・RLS バイパス）。
# サーバー専用。絶対に NEXT_PUBLIC_ を付けない。
SUPABASE_SECRET_KEY=

# --- OpenAI（FAQ 応答生成で必須）---------------------------------
# FAQ 応答を生成する。サーバー専用（絶対に NEXT_PUBLIC_ を付けない）。
OPENAI_API_KEY=

# 使うモデル（任意）。未設定なら gpt-4o-mini。品質が足りなければ gpt-4o に。
OPENAI_MODEL=

# --- LINE Messaging API（webhook で必須）--------------------------
# LINE Developers Console > チャネル作成後に発行される。
# webhook 応答の送信（reply API）に使うアクセストークン。サーバー専用。
LINE_CHANNEL_ACCESS_TOKEN=

# webhook の署名検証（x-line-signature）に使うチャネルシークレット。サーバー専用。
LINE_CHANNEL_SECRET=

# お知らせ一斉配信のテスト送信先 兼 オーナー通知先（任意）。管理者自身のLINE user id。
# 設定すると次の2つが有効になる:
#   - /admin/broadcasts に「テスト送信（自分にだけ届く）」ボタンが出る
#   - needs_human判定時（自動回答できない問い合わせ）にこのLINEへ通知が届く
# 値は /admin/conversations（ログ画面）に表示される line_user_id をコピーする。
LINE_TEST_USER_ID=

# --- 管理画面（/admin、FAQ管理で必須）------------------------------
# 管理画面のログインパスワード。第三者に推測されにくい値にする。
# サーバー専用（絶対に NEXT_PUBLIC_ を付けない）。
ADMIN_PASSWORD=
